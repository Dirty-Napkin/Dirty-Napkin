                    src="https://player.vimeo.com/video/1199239207?background=1&autoplay=1&loop=1&muted=1&controls=0" 
                    frameborder="0" 
                    allow="autoplay; fullscreen; picture-in-picture;" 
                    title="sil5_button-hover">
                </iframe>
            </div>

            <img src="assets/project-pages/sil6_postcard.jpg" alt="Postcard" class="width3" id="sil6">

            <p class="width6 narrow-text">
                The Lemonade Stand was built on gumption from the start. We were packed with work when AJ convinced us to take him on and we tried out a new <span class="italics">design sprint</span> model. We designed the logos in two weeks with meetings squeezed into lunch breaks, nights, and weekends. It was an absolute&nbsp;blast.
            </p>
            
            <div class="vimeo-video width6" id="sil7" style="--poster:url('assets/vimeo-thumbnails/sil7.jpg');padding:48.48% 0 0 0;">
