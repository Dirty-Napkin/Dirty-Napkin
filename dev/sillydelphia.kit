            </div>

            <img src="assets/project-pages/sil13_wayfinding.jpg" alt="Wayfinding" class="width4" id="sil13">
            
            <img src="assets/project-pages/sil14_strip-type.jpg" alt="Strip type" class="width2" id="sil14">

            <div class="vimeo-video width6" id="sil15" style="--poster:url('assets/vimeo-thumbnails/sil15.jpg');padding:48.48% 0 0 0;">
